# ===================================================================
# Smart Healthcare Appointment System - Environment Variables
# ===================================================================

# Database Configuration (MySQL 8.0+)
DB_URL=jdbc:mysql://localhost:3306/smart_health_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# Server Configuration
SERVER_PORT=8080

# JWT Security Settings
# Generate a secure 256-bit+ secret key for production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Doctor Recommendation Engine Configuration
# Supported providers: GEMINI, OPENAI, RULE_BASED
AI_PROVIDER=RULE_BASED

# Gemini AI Provider Configuration (Google AI Studio / Vertex AI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Provider Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Appointment Scheduling Business Policy
# Appointment cancellation cutoff before start time in hours
APPOINTMENT_CANCELLATION_CUTOFF_HOURS=2
CLINIC_TIMEZONE=UTC
